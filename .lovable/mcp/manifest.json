{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://yecacgdfdlytkxcwfqpx.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "dominebrasil",
      "version": "0.1.0",
      "title": "DomineBrasil"
    },
    "tools": [
      {
        "name": "get_my_profile",
        "title": "Meu perfil",
        "description": "Retorna o perfil e o papel (aluno, instrutor, investidor, admin) do usuário autenticado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_my_bookings",
        "title": "Minhas aulas agendadas",
        "description": "Lista as aulas do usuário autenticado (como aluno ou instrutor), com data, horário, status e valor. Permite filtrar por status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filtra pelo status da aula.",
              "type": "string",
              "enum": [
                "pending",
                "confirmed",
                "completed",
                "cancelled"
              ]
            },
            "limit": {
              "description": "Máximo de registros retornados.",
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "search_instructors",
        "title": "Buscar instrutores",
        "description": "Busca instrutores aprovados na plataforma, com preço por hora, avaliação, cidade e experiência. Aceita filtro por cidade e preço máximo.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "city": {
              "description": "Filtra por cidade (correspondência parcial, sem diferenciar maiúsculas).",
              "type": "string"
            },
            "maxPricePerHour": {
              "description": "Preço máximo por hora em reais.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "limit": {
              "description": "Máximo de instrutores retornados.",
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_my_transactions",
        "title": "Meu extrato financeiro",
        "description": "Lista as transações financeiras do usuário autenticado (créditos, débitos, saques) com valor, tipo e status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Máximo de transações retornadas.",
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_my_cars",
        "title": "Minha frota",
        "description": "Lista os veículos cadastrados pelo usuário autenticado (investidor), com placa, modelo, status e disponibilidade.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_car_maintenance",
        "title": "Histórico de manutenção",
        "description": "Lista os registros de manutenção dos veículos do usuário autenticado (tipo de serviço, custo, km e próxima revisão).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "carId": {
              "description": "Filtra por um veículo específico.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "limit": {
              "description": "Máximo de registros retornados.",
              "default": 30,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "add_car_maintenance",
        "title": "Registrar manutenção",
        "description": "Registra uma manutenção de um veículo do usuário autenticado (ex.: troca de óleo, pneus, motor), com custo, km e próxima revisão.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "carId": {
              "description": "ID do veículo (use list_my_cars).",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "type": {
              "description": "Tipo de serviço, ex.: 'Troca de óleo'.",
              "type": "string",
              "minLength": 1
            },
            "cost": {
              "description": "Custo do serviço em reais.",
              "default": 0,
              "type": "number",
              "minimum": 0
            },
            "date": {
              "description": "Data do serviço no formato YYYY-MM-DD. Padrão: hoje.",
              "type": "string"
            },
            "km": {
              "description": "Quilometragem atual do veículo.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "description": {
              "description": "Observações do serviço.",
              "type": "string"
            },
            "nextDate": {
              "description": "Data da próxima revisão (YYYY-MM-DD).",
              "type": "string"
            },
            "nextKm": {
              "description": "Quilometragem da próxima revisão.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "carId",
            "type"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
